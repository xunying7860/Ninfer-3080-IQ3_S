+bool causal_attention_prompt_fast_kernel(KvCacheStorage storage, bool requested) {
+#if defined(NINFER_SM70)
+    (void)storage;
+    (void)requested;
+    return false;
+#endif
+    const bool supported = storage == KvCacheStorage::Int8Group64 ||
+                           storage == KvCacheStorage::RotatedInt8KeyInt4ValueGroup64 ||
+                           storage == KvCacheStorage::RotatedLloyd4KeyInt4Value ||
+                           storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8 ||
+                           storage == KvCacheStorage::RotatedE8RootKeyInt4Value ||
+                           storage == KvCacheStorage::Nvfp4Group16;
+    if (!supported) { return false; }
+    if (requested) { return true; }
+    static const int forced = [] {
+        const char* value = std::getenv("NINFER_PROMPT_FAST");
+        return value == nullptr ? -1 : (value[0] == '1' ? 1 : 0);
+    }();
+    if (forced >= 0) { return forced == 1; }
+    return device_route_schedule("attn_prompt_fast", 1) == "on";
+}
+
+void causal_attention_prompt_attention_launch(const Tensor& q, const Tensor& positions, float scale,
+                                              const PagedKVLayerView& cache, Tensor& out, bool fast,
+                                              cudaStream_t stream) {
+    // KVarN G128（KvarnTile128）：量化平面读不了现成内核（bf16 分支会把 U8 码当 bf16 读）⇒
+    // 换成同页表/同物理页的 bf16 窗口视图（由 append 真解码填），再进来一次。
+    if (cache.storage == KvCacheStorage::KvarnTile128) {
+        PagedKVLayerView kvarn128_mirror;
+        if (!kvarn128_mirror_layer(cache, kvarn128_mirror, stream)) {
+            std::fprintf(stderr, "ninfer: KVarN128 prompt 消费端窗口不可用（tokens=%d）\n",
+                         (int)q.ne[2]);
+            std::fflush(stderr);
+            throw std::invalid_argument(
+                "causal_attention_prompt_attention_launch: KVarN128 consumer window unavailable");
+        }
+        return causal_attention_prompt_attention_launch(q, positions, scale, kvarn128_mirror, out,
+                                                       fast, stream);
+    }
+    // KVarN 的 plane 是 U8 码 + 跨 token 打包的通道 scale，现成内核（bf16 分支会把 U8 码当 bf16
+    // 直接读）读法不同：宁可在这里明确报错，也不要静默读出垃圾（plane_types.h 头注讲的就是这类错）。
+    if (cache.storage == KvCacheStorage::KvarnSinkhorn4KeyInt4ValueGroup64 ||
+        cache.storage == KvCacheStorage::KvarnSinkhorn4KeyInt2ValueGroup64) {
+        // 路线 B：把 plane 指针换成 bf16 mirror（编码时写进去的反量化值），storage 一并改成
+        // BFloat16 让现成 bf16 attention 内核自然接管 —— 它吃的值与路线 A 融合读核喂进 MMA 的同一份。
+        // 先按需预留（实机坑：graph 准备阶段就会跑到这里，那时还没有任何 append 触发过预留）
+        ninfer::ops::kvarn_ensure_pools(static_cast<int>(cache.k_pages.ne[3]), static_cast<int>(cache.num_kv_heads), stream);
+        void* mk = ninfer::ops::kvarn_mirror_k();
+        void* mv = ninfer::ops::kvarn_mirror_v();
+        if (mk == nullptr || mv == nullptr) {
+            // 上层会吞掉异常文本（实机复现：warmup 里抛、日志一个字都没有）⇒ 先无条件写 stderr。
+            std::fprintf(stderr, "ninfer: KVarN KV storage needs the bf16 mirror pool (prompt path); it must be allocated before CUDA Graph capture\n");
+            throw std::invalid_argument(
+                "KVarN KV storage: bf16 mirror pool not available (prompt path)");
+        }
+        static bool traced_prompt = false;
+        if (!traced_prompt && std::getenv("NINFER_KVARN_DEBUG") != nullptr) {
+            traced_prompt = true;
+            std::fprintf(stderr, "kvarn trace: prompt 换成 mirror view pages=%lld heads=%d\n",
+                         (long long)cache.k_pages.ne[3], (int)cache.num_kv_heads);
+        }
+        PagedKVLayerView mirror_cache   = cache;      // 只换 plane 指针与 storage；block_table/head 数不动
+        mirror_cache.k_pages.data       = mk;
+        mirror_cache.v_pages.data       = mv;
+        mirror_cache.k_scale_pages      = Tensor();
+        mirror_cache.v_scale_pages      = Tensor();
+        mirror_cache.storage            = KvCacheStorage::BFloat16;
+        return causal_attention_prompt_attention_launch(q, positions, scale, mirror_cache, out, fast, stream);
+    }
+
+    if (cache.storage == KvCacheStorage::Fp8KeyNvfp4Value) {
+        causal_attention_prompt_k8v4_attention_launch(q, positions, scale, cache, out, stream);
+        return;
+    }
+    if (cache.storage == KvCacheStorage::Nvfp4Group16) {
+        causal_attention_prompt_nvfp4_attention_launch(q, positions, scale, cache, out, stream);
+        return;
+    }
+    if (cache.storage == KvCacheStorage::Fp8E4M3Row256) {
+        causal_attention_prompt_fp8_attention_launch(q, positions, scale, cache, out, stream);
+        return;
+    }
+    const PagedKVDirectMetadata metadata{static_cast<const std::int32_t*>(cache.block_table.data)};
+    if (q.ne[1] == CausalD256H24Kv4::QHeads) {
+        causal_attention_prompt_attention_launch_for<CausalD256H24Kv4>(q, positions, scale, cache,
+                                                                       metadata, out, fast, stream);
+        return;
+    }
+    causal_attention_prompt_attention_launch_for<CausalD256H16Kv2>(q, positions, scale, cache,
+                                                                   metadata, out, fast, stream);
+}
+
+void causal_attention_prompt_launch(const Tensor& q, const Tensor& k, const Tensor& v,
+                                    const Tensor& positions, const Tensor& valid_columns,
+                                    const Tensor& table_rows, float scale,
+                                    PagedKVBatchLayerView cache, Tensor& out, bool fast,
+                                    cudaStream_t stream) {
+    if (cache.storage == KvCacheStorage::Fp8KeyNvfp4Value) {
+        causal_attention_prompt_k8v4_launch(q, k, v, positions, valid_columns, table_rows, scale,
+                                            cache, out, stream);
+        return;
+    }
+    if (cache.storage == KvCacheStorage::Nvfp4Group16) {
+        causal_attention_prompt_nvfp4_launch(q, k, v, positions, valid_columns, table_rows, scale,
+                                             cache, out, stream);
+        return;
+    }
+    if (cache.storage == KvCacheStorage::Fp8E4M3Row256) {
+        causal_attention_prompt_fp8_launch(q, k, v, positions, valid_columns, table_rows, scale,
+                                           cache, out, stream);
+        return;
+    }
+    kv_cache_append_batch_launch(k, v, positions, valid_columns, table_rows, cache, stream);
+    // KVarN128：量化 append 已在上面完成（窗口也在 append 里真解码填好）⇒ 换 bf16 窗口视图再往下走，
+    // 否则现成 prompt 核会把 U8 码当 bf16 读（静默垃圾）。
+    PagedKVBatchLayerView read_cache = cache;
+    if (cache.storage == KvCacheStorage::KvarnTile128) {
+        if (!kvarn128_mirror_batch(cache, read_cache, stream)) {
+            std::fprintf(stderr, "ninfer: KVarN128 prompt(batch) 消费端窗口不可用（width=%d batch=%d）\n",
+                         (int)q.ne[2], (int)q.ne[3]);
+            std::fflush(stderr);
+            throw std::invalid_argument(
+                "causal_attention_prompt_launch: KVarN128 consumer window unavailable");
+        }
+    }
+    const auto launch = [&]<bool Masked>() {
+        const PagedKVBatchMetadata<Masked> metadata{
+            .tables = static_cast<const std::int32_t*>(read_cache.block_tables.data),
+            .valid_columns =
+                Masked ? static_cast<const std::int32_t*>(valid_columns.data) : nullptr,
+            .table_rows   = static_cast<const std::int32_t*>(table_rows.data),
+            .table_stride = read_cache.block_tables.ne[0],
+        };
+        if (q.ne[1] == CausalD256H24Kv4::QHeads) {
+            causal_attention_prompt_attention_launch_for<CausalD256H24Kv4>(
+                q, positions, scale, read_cache, metadata, out, fast, stream);
+            return;
+        }
+        causal_attention_prompt_attention_launch_for<CausalD256H16Kv2>(q, positions, scale, read_cache,
+                                                                       metadata, out, fast, stream);
+    };
+    if (valid_columns.data == nullptr) {
+        launch.template operator()<false>();
+    } else {
+        launch.template operator()<true>();
+    }
+}
+
+} // namespace ninfer::ops::detail
