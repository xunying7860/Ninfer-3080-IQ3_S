+    Tensor k;
+    Tensor v;
+    if (!kvarn128_window_tensors(cache.k_pages, cache.num_kv_heads, stream, k, v)) { return false; }
+    mirror               = cache;
+    mirror.k_pages       = k;
+    mirror.v_pages       = v;
+    mirror.k_scale_pages = Tensor();
+    mirror.v_scale_pages = Tensor();
+    mirror.storage       = KvCacheStorage::BFloat16;
+    return true;
