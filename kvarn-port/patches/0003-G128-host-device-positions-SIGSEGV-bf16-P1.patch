-std::int32_t causal_attention_split_capacity(std::int32_t q_heads, std::int32_t tokens,
-                                             KvCacheStorage cache_storage,
-                                             CausalAttentionExecutionEnvelope envelope,
-                                             std::int32_t batch_size) {
