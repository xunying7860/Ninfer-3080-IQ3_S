+// 取窗口张量（同页表/同物理页的 bf16 平面，形状与 bf16 缓存的 k_pages 完全一致）。
+bool kvarn128_window_tensors(const Tensor& code_plane, std::int32_t kv_heads, cudaStream_t stream,
+                             Tensor& k_out, Tensor& v_out) {
+    if (code_plane.data == nullptr || code_plane.ne[3] <= 0) { return false; }
+    void* win_k = nullptr;
+    void* win_v = nullptr;
+    if (!kvarn128_window(code_plane.data, code_plane.ne[3], kv_heads, stream, &win_k, &win_v)) {
+        return false;
+    }
+    const std::int32_t leading = static_cast<std::int32_t>(kvarn128_window_leading());
+    k_out = Tensor(win_k, DType::BF16, {leading, kPagedKVPageSize, kv_heads, code_plane.ne[3]});
+    v_out = Tensor(win_v, DType::BF16, {leading, kPagedKVPageSize, kv_heads, code_plane.ne[3]});
+    return true;
+}
+
