diff --git a/apps/perplexity/main.cpp b/apps/perplexity/main.cpp
index 018d37a..b648989 100644
--- a/apps/perplexity/main.cpp
+++ b/apps/perplexity/main.cpp
@@ -95,7 +95,7 @@ std::string usage_text() {
            "       [--ngram-table PATH] [--ngram-residency disk|ram|ram-hot] [--ngram-lock]\n"
            "       [--ngram-io buffered|direct|mmap] [--ngram-io-depth N] [--ngram-ram-mib N]\n"
            "       [--ngram-hot-profile PATH] [--no-ngram-table]   (Qwen3.8-Flash-Next)\n"
-           "       [--kv-dtype bf16|int8|fp8|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8|nvfp4|k8v4] [--output "
+           "       [--kv-dtype bf16|int8|fp8|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8|nvfp4|k8v4|kvarn128|kvarn|kvarn2] [--output "
            "<directory>]\n"
            "       [--lm-head-q4|--lm-head-q6] [--embedding-q4|--embedding-q6] [--mtp-experts-q4] "
            "[--gdn-state-fp16]\n"
@@ -177,9 +177,16 @@ Options parse_options(int argc, char** argv) {
                 out.kv = ninfer::KvCacheStorage::Nvfp4Group16;
             } else if (dtype == "k8v4") {
                 out.kv = ninfer::KvCacheStorage::Fp8KeyNvfp4Value;
+            } else if (dtype == "kvarn128") {
+                // G128 KVarN 全档位：页级 Sinkhorn 平衡后的 tile-128 量化（K/V 位宽由 profile 决定）。
+                out.kv = ninfer::KvCacheStorage::KvarnTile128;
+            } else if (dtype == "kvarn") {
+                out.kv = ninfer::KvCacheStorage::KvarnSinkhorn4KeyInt4ValueGroup64;
+            } else if (dtype == "kvarn2") {
+                out.kv = ninfer::KvCacheStorage::KvarnSinkhorn4KeyInt2ValueGroup64;
             } else {
                 usage_error("--kv-dtype must be bf16, int8, fp8, rk8v4, rk4v4, rk4v4-e8, "
-                            "rk2v4-e8, nvfp4, or k8v4");
+                            "rk2v4-e8, nvfp4, k8v4, kvarn128, kvarn, or kvarn2");
             }
         } else if (option == "--output") {
             out.output = std::filesystem::path(value("--output"));
