+#!/usr/bin/env python3
+"""G128 KVarN 短提示词探针。
+
+用法：
+  python3 req_probe.py calib  -> 校准出精确 106/51/1 token 的题面，写 prompts.json
+  python3 req_probe.py run    -> 读 prompts.json，逐个发固定题面（temperature=0），打印原始输出
+
+题面在两次运行之间逐字相同，所以 kvarn128 与 rk4v4 两臂可用同一份 prompts.json 对照。
+"""
+import json
+import os
+import sys
+import urllib.request
+
+PORT = os.environ.get("PORT", "18093")
+URL = "http://127.0.0.1:%s/v1/completions" % PORT
+HERE = os.path.dirname(os.path.abspath(__file__))
+STATE = os.path.join(HERE, "prompts.json")
+
+SEED = "Question: 17*23 = ? Answer with just the number.\nAnswer:"
+FILLER = " the"
+TARGETS = [106, 51, 1]
+
+
+def call(prompt, max_tokens, temperature=0.0, timeout=900):
+    body = json.dumps({"prompt": prompt, "max_tokens": max_tokens,
+                       "temperature": temperature, "stream": False}).encode("utf-8")
+    req = urllib.request.Request(URL, data=body,
+                                 headers={"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=timeout) as r:
+        return json.loads(r.read().decode("utf-8"))
+
+
+def ptokens(prompt):
+    return call(prompt, 1)["usage"]["prompt_tokens"]
+
+
+def calib(target):
+    if target <= 2:
+        for cand in ["1", "The", "A", "France", "def", "ok", "4"]:
+            try:
+                pt = ptokens(cand)
+            except Exception as exc:  # noqa: BLE001
+                print("  cand %r 失败 %s" % (cand, exc), flush=True)
+                continue
+            print("  cand %r prompt_tokens=%d" % (cand, pt), flush=True)
+            if pt == target:
+                return cand
+        return None
+    n = 0
+    for it in range(12):
+        prompt = FILLER * n + SEED
+        pt = ptokens(prompt)
+        print("  calib[%d] it=%d pad=%d prompt_tokens=%d" % (target, it, n, pt), flush=True)
+        if pt == target:
+            return prompt
+        n += (target - pt)
+        if n < 0:
+            n = 0
+            if pt > target:
+                return None
+    return None
+
+
+def main():
+    mode = sys.argv[1] if len(sys.argv) > 1 else "run"
+    if mode == "one":
+        # one <pad> [max_tokens]：只发一条 FILLER*pad + SEED（用于让"第一个 append"就落在 <128 token）
+        pad = int(sys.argv[2]) if len(sys.argv) > 2 else 90
+        mx = int(sys.argv[3]) if len(sys.argv) > 3 else 64
+        prompt = FILLER * pad + SEED
+        r = call(prompt, mx)
+        u = r.get("usage", {})
+        ch = r["choices"][0]
+        print("== one pad=%d prompt_tokens=%s completion_tokens=%s finish=%s ==" %
+              (pad, u.get("prompt_tokens"), u.get("completion_tokens"),
+               ch.get("finish_reason")), flush=True)
+        print("   text=%r" % ch.get("text"), flush=True)
+        return 0
+    if mode == "calib":
+        out = {}
+        for t in TARGETS:
+            print("== 校准 target=%d ==" % t, flush=True)
