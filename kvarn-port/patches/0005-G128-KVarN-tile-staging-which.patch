+# host 侧 dump 探针在 replay 里根本不会被调用（capture 里又禁止 cudaMemcpy D2H）。
+# 只有关掉 CUDA Graph，每个 append 才真的走 host 代码，dump 才拿得到数。
+set -u
+ROOT=/data/kvarn/g128-engine
+BIN=$ROOT/bin/ninfer-serve
+LOADER=/data/ninfer/bundle/libs/lib64/ld-linux-x86-64.so.2
+LIBPATH=/data/ninfer/bundle/libs/lib/x86_64-linux-gnu:/usr/local/cuda-13.3/lib64:/usr/lib/x86_64-linux-gnu
+MODEL=/data/nvme/ninfer-models/Qwen3.8-27B-Coder390-EfficientThink-Q2LynnStyle-MTP.ninfer
+export CUDA_VISIBLE_DEVICES=0
+KV=${KV_DTYPE:-kvarn128}
+CTX=${CTX_TOKENS:-16384}
+PORT=${PORT:-18093}
+mkdir -p "$ROOT/logs"
+exec "$LOADER" --library-path "$LIBPATH" "$BIN" "$MODEL" \
+  --host 127.0.0.1 --port "$PORT" --model-id "qwen3.8-27b-${KV}" \
+  --max-context "$CTX" --kv-capacity "$CTX" --kv-dtype "$KV" \
+  --device-profile-path "$ROOT/device-profiles.json" \
+  --no-cuda-graph \
+  --max-concurrency 1 --max-pending-requests 4 --prefill-chunk 1024 \
+  --device-state-slots 1 --host-state-slots 1 --host-kv-mib 256 --context-cache-policy rolling \
+  --media-cache-mib 128 --media-live-mib 256 \
+  --gdn-state-fp16 --spec mtp --draft-tokens 3 --adaptive-mtp \
+  --chat-template /data/ninfer/chat_template.jinja \
+  --default-reasoning-effort high --default-max-tokens 64 \
