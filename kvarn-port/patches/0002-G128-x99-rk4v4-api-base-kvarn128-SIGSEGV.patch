+#!/bin/bash
+# G128 KVarN 候选件 smoke（骨架照抄 /data/kvarn/ninfer-kvarn/run-smoke.sh，容器/目录独立，
+# 不用旧的 KVARN_STAGING_PAGES；device-profile 独立一份）。
