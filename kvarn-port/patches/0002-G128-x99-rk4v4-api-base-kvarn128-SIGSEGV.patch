+#!/bin/bash
+# 起一个 G128 候选实例（一次只起一个；判活只认引擎自己报的行）
+dtype=${1:-kvarn128}
+ctx=${2:-65536}
+port=${3:-18093}
+TS=$(date +%Y%m%d-%H%M%S)
+LOGDIR=/data/kvarn/g128-engine/logs
