+#!/usr/bin/env bash
+# G128 路线的容器内构建入口（engine-g128 专用；容器 g128build / 卷 g128vol，与旧 kvarn-build/kvarnbuild 隔离）。
+# 与旧路线不同的一点：**不把源码 cp -a 进卷**（R12 坑：cp -a 保时间戳 + ninja 按时间戳判新 ⇒ 改动不生效）。
+# 这里直接 cmake -S /src -B /w/build（bind mount 的 mtime 就是真 mtime），构建产物在卷里，增量重编只看真 mtime。
+# 并发：宿主 store.sh 不限并发（CPU+2）会 OOM；本机 12 核/16 GB ⇒ 逐级降档 + -k 0 keep-going。
+export DEBIAN_FRONTEND=noninteractive
+if [ ! -f /w/.apt_done ]; then
+  apt-get update -q
+  apt-get install -y -q cmake ninja-build pkg-config git libavformat-dev libavcodec-dev libavutil-dev libswscale-dev libcurl4-openssl-dev
+  touch /w/.apt_done
+fi
+cd /src
+export CUDACXX=/usr/local/cuda/bin/nvcc
+export PATH="$(dirname "$CUDACXX"):$PATH"
+echo "== nvcc: $(nvcc --version | tail -1)"
+echo "== 源码指纹（确认 bind mount 看见的是我改过的树）"
+md5sum "$1" 2>/dev/null || true
+if [ ! -f /w/build/build.ninja ]; then
+  echo "== configure =="
+  cmake -S /src -B /w/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES=86 -DNINFER_BUILD_BENCHMARKS=OFF
+  echo CONFIGURE_RC=$?
+fi
+rc=1
+for jobs in 8 6 4 2; do
+  echo "----- pass -j $jobs -----"
+  cmake --build /w/build --target ninfer-serve -j $jobs -- -k 0
+  rc=$?
+  echo "PASS_RC[$jobs]=$rc"
+  if [ $rc -eq 0 ]; then break; fi
+  echo "有 target 失败（多为 OOM 被杀），降档重试"
+done
+echo "BUILD_RC=$rc"
+find /w/build -name ninfer-serve -type f -printf 'PRODUCT %s %p\n' 2>/dev/null | head -3
+echo DONE-BUILD
diff --git a/build_check/kvarn128_gate.cu b/build_check/kvarn128_gate.cu
