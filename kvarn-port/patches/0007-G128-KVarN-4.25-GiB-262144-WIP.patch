diff --git a/src/core/paged_kv_cache.h b/src/core/paged_kv_cache.h
index d7d7e3e..de07e6e 100644
--- a/src/core/paged_kv_cache.h
+++ b/src/core/paged_kv_cache.h
@@ -331,6 +331,13 @@ public:
                         std::span<const DeviceKVPageHandle> destination,
                         RankStreams streams = {}) const;
 
+    // Physical page number of `handle`, as the execution tables store it. Exposed for consumers
+    // that must mirror a page pool's layout outside the table pool (the KVarN bf16 window keeps a
+    // lazily backed plane indexed by these numbers).
+    [[nodiscard]] std::int32_t index_of(DeviceKVPageHandle handle) const {
+        return physical_index(handle);
+    }
+
 private:
     friend class DeviceKVPageLease;
     friend class DeviceKVPageReservation;
