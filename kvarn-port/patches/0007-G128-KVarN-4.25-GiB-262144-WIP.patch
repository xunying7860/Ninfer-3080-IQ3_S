index bf54391..193658b 100644
--- a/src/models/qwen3_5/program/program_impl.cpp
+++ b/src/models/qwen3_5/program/program_impl.cpp
@@ -9,6 +9,7 @@
 #include "core/device.h"
 #include <cuda_runtime.h>
 #include "ninfer/ops/target_logprobs.h"
+#include "ops/kv_cache/append/kvarn128_launch.h"
 
 #include <algorithm>
 #include <cstddef>
@@ -650,6 +651,11 @@ ProgramImpl::ProgramImpl(const execution::Parameters& parameters_in, const Seque
     work.reset_peak();
     workspace_logical_peak_bytes = 0;
     create_hybrid_prefix_cache(startup_observer);
+    // KVarN128：惰性 bf16 消费窗口的物理后备在启动热身/抓图全部结束后释放（虚拟地址保留）。
+    // 空闲态窗口不占显存；真实请求由 ensure_sequence_kv_mapped 按覆盖量重新提交，且一定发生在
+    // 读到这些页的 attention 之前（append 先写后读）。不是 KVarN128 时窗口数为 0 ⇒ no-op。
+    device.synchronize();
+    ops::kvarn128_window_release_backing();
 }
 
 void ProgramImpl::synchronize_transfer_streams() const {
diff --git a/src/models/qwen3_5/program/storage/context.cpp b/src/models/qwen3_5/program/storage/context.cpp
index 9085edc..25b91f8 100644
--- a/src/models/qwen3_5/program/storage/context.cpp
+++ b/src/models/qwen3_5/program/storage/context.cpp
@@ -1,6 +1,7 @@
 #include "models/qwen3_5/program/program_impl.h"
 #include "models/qwen3_5/program/context_work.h"
 #include "core/device.h"
+#include "ops/kv_cache/append/kvarn128_launch.h"
 
 #include <algorithm>
 #include <array>
@@ -1709,6 +1710,10 @@ void ProgramImpl::ensure_sequence_kv_mapped(SequenceState& sequence, std::uint32
         backend_kv_addresses->ensure_mapped_to_tokens(*sequence.kv->backend, backend_tokens,
                                                       compute_streams);
     }
+    // KVarN128：bf16 消费窗口的物理后备按 KV 页实际落地量同步提交（惰性窗口，见
+    // ops/kv_cache/append/kvarn128_launch.cu）。窗口必须在读到这些页的 attention 之前有物理
+    // 后备，所以这里与 KV 页 materialize 同步；不是 KVarN128 时 g_window_count==0 ⇒ no-op。
+    ops::kvarn128_window_commit_tokens(static_cast<int>(std::max(main_tokens, backend_tokens)));
 }
 
 void ProgramImpl::commit_sequence_kv(SequenceState& sequence, std::uint32_t main_tokens,
