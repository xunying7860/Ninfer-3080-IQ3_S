index b7ece02..ccfab09 100644
--- a/src/models/qwen3_5/program/planning/startup.cpp
+++ b/src/models/qwen3_5/program/planning/startup.cpp
@@ -27,6 +27,7 @@
 #include "ninfer/ops/speculative_round.h"
 #include <algorithm>
 #include <cstdlib>
+#include <cstdio>
 #include <initializer_list>
 #include <limits>
 #include <stdexcept>
@@ -984,6 +985,19 @@ void validate_target_options(const execution::Parameters& parameters, DeviceCont
                                     " devices are attached");
     }
     const std::uint32_t logical_pages = page_count(options.max_context);
+    // KVarN G128 的 tile = 2 逻辑页（kvarn128_launch.cu 取 bt[2*tile] 与 bt[2*tile+1]），而块表
+    // 长度 = page_count(max_context)：页数为奇数时最后一个 tile 的 page1 索引 = 长度本身 = 越界
+    // 一格（例：max_context=192 ⇒ 3 页 ⇒ 第 2 个 tile 越界）。所以这条 storage 要求 max_context
+    // 是 128 的倍数（⇔ 页数为偶数）。**不改 page_count 本身**（所有档位共用）。
+    if (options.kv_cache == KvCacheStorage::KvarnTile128 && (logical_pages % 2U) != 0U) {
+        std::fprintf(stderr,
+                     "ninfer: kvarn128 要求 max_context 是 128 的倍数（块表页数须为偶数）；"
+                     "收到 max_context=%u ⇒ page_count=%u 页，最后一个 tile 的 page1 会越界一格\n",
+                     options.max_context, logical_pages);
+        std::fflush(stderr);
+        throw std::invalid_argument(
+            "kvarn128 requires max_context to be a multiple of 128 (even block-table page count)");
+    }
     const std::uint32_t minimum_pages = std::max(logical_pages, options.max_concurrency);
     const std::uint64_t maximum_pages64 =
         maximum_main_page_groups(options.max_concurrency, logical_pages, options.context_cache);
