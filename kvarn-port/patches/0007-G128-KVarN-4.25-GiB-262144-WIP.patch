 #include <array>
@@ -885,6 +886,7 @@ public:
             free_[index] = address_capacity - 1U - index;
         }
         publish_scratch_.reserve(page_capacity_);
+        window_pages_scratch_.reserve(page_capacity_);
     }
 
     KVAddressSpaceStore(const KVAddressSpaceStore&)            = delete;
@@ -1640,6 +1642,11 @@ public:
                 " entitlement=" + std::to_string(entitlement(address)));
         }
         if (target <= address.page_count) { return; }
+        // KVarN128：bf16 消费窗口的**物理后备**与 KV 页落地量同步提交（惰性窗口，见
+        // ops/kv_cache/append/kvarn128_launch.cu）。这条是 KV 覆盖量扩展的唯一汇聚点
+        // （prefill / decode / causal scoring / graft 都走它），所以挂在这里最省事也最不容易漏。
+        // 不是 KVarN128 时窗口数为 0 ⇒ no-op；提交失败会 fprintf+fflush 后 throw。
+        ::ninfer::ops::kvarn128_window_commit_tokens(static_cast<int>(tokens));
         const std::uint32_t begin       = address.page_count;
         const std::uint32_t count       = target - begin;
         const std::size_t address_index = static_cast<std::size_t>(&address - addresses_.data());
@@ -1655,6 +1662,16 @@ public:
                 publish_scratch_.push_back(pages_->physical(page));
             }
             tables_->publish(address.row->handle(), begin, publish_scratch_, stream);
+            // KVarN128：惰性 bf16 窗口的物理后备按**实际落地的物理页号**提交（不是逻辑页数 ——
+            // 第二个请求拿到的新地址空间物理页号可能整段在「逻辑页数」推出的已提交区之外，
+            // 实机 = 第二次整窗 prefill 报 illegal address）。不是 KVarN128 时窗口数为 0 ⇒ no-op。
+            window_pages_scratch_.clear();
+            window_pages_scratch_.reserve(publish_scratch_.size());
+            for (const DeviceKVPageHandle page : publish_scratch_) {
+                window_pages_scratch_.push_back(pages_->physical_pool().index_of(page));
+            }
+            ::ninfer::ops::kvarn128_window_commit_physical_pages(
+                window_pages_scratch_.data(), static_cast<int>(window_pages_scratch_.size()));
         } catch (...) {
             for (LogicalKVPageHandle& page : added) {
                 pages_->dematerialize(page, address.reservation);
@@ -2064,6 +2081,7 @@ private:
     std::vector<std::uint32_t> free_;
     std::vector<LogicalKVPageHandle> memberships_;
