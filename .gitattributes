# 本仓库是 Linux 部署仓库：脚本/单元/配置一律以 LF 入库，检出也用 LF。
* text=auto eol=lf

# 二进制原样
*.png binary
*.webp binary
*.tar.gz binary
*.json -text

# 引擎 bundle 分卷：二进制、不做 CRLF 转换（内容是高熵数据，binary 同时禁掉 delta/zlib）
*.zst binary
*.tar.zst.part-* binary -delta

# —— KVarN 取证数据件：原样存，不做 eol 转换、不做 delta ——
*.bin binary
*.dump binary
*.dec binary
*.bad binary
*.i64 binary
*.mp3 binary
kvarn-evidence/wht-gate/gate binary
kvarn-port/patches/*.patch text eol=lf

# —— 取证数据：byte 级原样，保证与 checksums.txt 逐条对得上 ——
kvarn-evidence/** -text
